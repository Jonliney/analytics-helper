{
  "schemaVersion": 4,
  "propertySets": [],
  "events": [
    {
      "name": "Signup Completed",
      "domain": "auth",
      "key": "signupCompleted",
      "propertySets": [],
      "description": "User completes account registration",
      "purpose": "Measure successful registration and acquisition performance",
      "allowAdditionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "description": "Authentication method used for registration",
          "optional": false,
          "enum": [
            "email",
            "google",
            "apple"
          ],
          "allowOtherValues": false
        },
        "campaign_id": {
          "type": "string",
          "description": "Acquisition campaign identifier, when available",
          "optional": true,
          "allowOtherValues": false
        }
      },
      "status": "active"
    },
    {
      "name": "signup_started",
      "domain": "auth",
      "key": "signupStarted",
      "propertySets": [],
      "description": "User begins account registration",
      "allowAdditionalProperties": true,
      "properties": {
        "method": {
          "type": "string",
          "description": "Authentication method selected for registration",
          "optional": false,
          "enum": [
            "email",
            "google",
            "apple"
          ],
          "allowOtherValues": true
        }
      },
      "status": "active"
    }
  ]
}
