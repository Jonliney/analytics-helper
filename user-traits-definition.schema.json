{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://company.example/schemas/analytics-user-traits-definition.schema.json",
  "$ref": "#/definitions/userTraitsDefinition",
  "definitions": {
    "userTraitsDefinition": {
      "title": "Analytics user traits definition",
      "description": "The company-wide contract for durable traits associated with an identified user.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "allowAdditionalTraits": {
          "default": false,
          "description": "Allow undeclared user traits while continuing to enforce declared required traits. Defaults to false.",
          "type": "boolean"
        },
        "traits": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/propertyDefinition"
          }
        }
      },
      "required": [
        "description",
        "traits"
      ],
      "additionalProperties": false
    },
    "propertyDefinition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "default": false,
              "type": "boolean"
            },
            "enum": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "allowOtherValues": {
              "default": false,
              "description": "Treat enum entries as recommended values rather than an exhaustive set. Defaults to false.",
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "A string property may optionally declare exhaustive or recommended values.",
          "dependencies": {
            "allowOtherValues": [
              "enum"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
