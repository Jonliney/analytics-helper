{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://company.example/schemas/analytics-event-definition.schema.json",
  "anyOf": [
    {
      "$ref": "#/definitions/eventDefinition"
    },
    {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/eventDefinition"
      }
    }
  ],
  "title": "Analytics event definition file",
  "description": "A file may contain one event definition or an array of event definitions.",
  "definitions": {
    "eventDefinition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "description": "Stable event name sent to the analytics provider exactly as authored. Naming style is unrestricted; surrounding whitespace is not allowed."
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "description": "Team responsible for the event definition."
            },
            "allowAdditionalProperties": {
              "default": false,
              "description": "Allow undeclared event properties while continuing to enforce declared required properties. Defaults to false.",
              "type": "boolean"
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              },
              "additionalProperties": {
                "$ref": "#/definitions/propertyDefinition"
              }
            },
            "status": {
              "default": "active",
              "description": "Lifecycle status. Defaults to active.",
              "type": "string",
              "const": "active"
            }
          },
          "required": [
            "name",
            "description",
            "owner",
            "properties"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "description": "Stable event name sent to the analytics provider exactly as authored. Naming style is unrestricted; surrounding whitespace is not allowed."
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "description": "Team responsible for the event definition."
            },
            "allowAdditionalProperties": {
              "default": false,
              "description": "Allow undeclared event properties while continuing to enforce declared required properties. Defaults to false.",
              "type": "boolean"
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              },
              "additionalProperties": {
                "$ref": "#/definitions/propertyDefinition"
              }
            },
            "status": {
              "type": "string",
              "const": "deprecated"
            },
            "deprecatedSince": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "description": "ISO date on which consumers were told to migrate."
            },
            "replacement": {
              "description": "Active event that consumers should use instead, when available.",
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          },
          "required": [
            "name",
            "description",
            "owner",
            "properties",
            "status",
            "deprecatedSince"
          ],
          "additionalProperties": false
        }
      ]
    },
    "propertyDefinition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "default": false,
              "type": "boolean"
            },
            "enum": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "allowOtherValues": {
              "default": false,
              "description": "Treat enum entries as recommended values rather than an exhaustive set. Defaults to false.",
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "A string property may optionally declare exhaustive or recommended values.",
          "dependencies": {
            "allowOtherValues": [
              "enum"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
