{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://company.example/schemas/analytics-event-definition.schema.json",
  "anyOf": [
    {
      "$ref": "#/definitions/eventDefinition"
    },
    {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/eventDefinition"
      }
    }
  ],
  "title": "Analytics event definition file",
  "description": "A file may contain one event definition or an array of event definitions.",
  "definitions": {
    "eventDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Za-z0-9]*(?: [A-Z0-9][A-Za-z0-9]*)*$",
          "description": "Stable Title Case event name sent to the analytics provider, such as Signup Started."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Team responsible for the event definition."
        },
        "allowAdditionalProperties": {
          "default": false,
          "description": "Allow undeclared event properties while continuing to enforce declared required properties. Defaults to false.",
          "type": "boolean"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/propertyDefinition"
          }
        }
      },
      "required": [
        "name",
        "description",
        "owner",
        "properties"
      ],
      "additionalProperties": false
    },
    "propertyDefinition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "default": false,
              "type": "boolean"
            },
            "enum": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "allowOtherValues": {
              "default": false,
              "description": "Treat enum entries as recommended values rather than an exhaustive set. Defaults to false.",
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "A string property may optionally declare exhaustive or recommended values.",
          "dependencies": {
            "allowOtherValues": [
              "enum"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
